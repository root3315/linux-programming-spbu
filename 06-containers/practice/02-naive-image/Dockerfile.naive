# НАИВНЫЙ вариант: компилятор живёт в том же образе, что и программа.
# Работает, но образ получается огромным — в нём остаются apt, gcc, заголовки.
FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc make libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY app/ .

RUN make

CMD ["./hello", "world", "/app/data.txt"]
