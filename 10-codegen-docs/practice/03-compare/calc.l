/* calc.l — «глаза» калькулятора: разбивает строку на слова-токены.
 *
 * flex читает этот файл и создаёт функцию yylex(), которая по очереди
 * возвращает токены: число, плюс, минус, скобку.
 *
 * Правило: САМОЕ ДЛИННОЕ совпадение выигрывает, при равенстве — верхнее.
 */
%{
#include "calc.tab.h"     /* там объявлены NUM и yyval */
#include <stdlib.h>
%}

%option noyywrap

%%

[0-9]+(\.[0-9]+)?   { yylval = atof(yytext); return NUM; }
[ \t]+              { /* пробелы просто пропускаем */ }
"+"                 { return '+'; }
"-"                 { return '-'; }
"*"                 { return '*'; }
"/"                 { return '/'; }
"%"                 { return '%'; }
"^"                 { return '^'; }
"("                 { return '('; }
")"                 { return ')'; }
"\n"                { return '\n'; }
"#".*               { /* комментарий до конца строки */ }
.                   { return yytext[0]; }   /* всё остальное — как есть */

%%
